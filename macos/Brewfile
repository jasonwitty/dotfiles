# macOS packages for this setup. Install with: brew bundle --file macos/Brewfile
tap "nikitabobko/tap"        # AeroSpace
tap "felixkratz/formulae"    # JankyBorders

# Window manager, borders, terminal
cask "aerospace"
brew "borders"
cask "ghostty"
cask "font-hack-nerd-font"

# Shell and prompt
brew "fish"
brew "starship"
brew "zoxide"
brew "fzf"
brew "tmux"

# Tools the fish config aliases or calls
brew "eza"        # ls, la, ll, lt
brew "bat"        # cat, man pager
brew "ugrep"      # grep, egrep, fgrep

# Neovim (LazyVim) and what it needs
brew "neovim"
brew "ripgrep"          # live grep
brew "fd"               # file finder
brew "tree-sitter-cli"  # builds syntax parsers
brew "lazygit"          # Space g g

# Extras installed on this machine
brew "micro"
brew "fastfetch"
brew "gh"
