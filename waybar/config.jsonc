{
  "modules-left": [
    "custom/launcher",
    "wlr/taskbar"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "pulseaudio",
    "network",
    "tray"
  ],
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "format": "CPU {usage}%"
  },
  "memory": {
    "format": "MEM {percentage}%"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮"
  },
  "custom/launcher": {
    "format": "",
    "on-click": "rofi -show drun"
  }
}